# MIRA Environment Variables
# IMPORTANT: Add .env to .gitignore!

# Firebase Configuration (get from Firebase Console > Project Settings > General)
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=mira-platform.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=mira-platform
VITE_FIREBASE_STORAGE_BUCKET=mira-platform.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# MIRA Application Configuration
VITE_MIRA_APP_ID=mira-platform
VITE_MIRA_FUNCTIONS_VERSION=v2
VITE_MIRA_APP_BASE_URL=https://mira-platform.web.app
VITE_MIRA_LEGACY_SDK_IMPORTS=false

# Optional: Chain data providers (deixe vazio para usar dados mockados no protótipo)
# Em produção, configure uma das opções:
#   Blockchair: https://blockchair.com/api
#   Mempool.space: https://mempool.space/api
#   Etherscan: https://api.etherscan.io/api
VITE_MIRA_CHAIN_PROVIDER=mock
VITE_MIRA_CHAIN_API_KEY=
